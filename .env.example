# Vorlage – echte Werte NIE ins Repository committen. Auf dem Hoster als Umgebungsvariablen setzen.
OPENROUTER_API_KEY=
ACCESS_CODES=LUMEN-BEISPIEL-1,LUMEN-BEISPIEL-2
SESSION_SECRET=
DAILY_LIMIT_PER_CODE=20
DAILY_LIMIT_PER_IP=30
DAILY_BUDGET_USD=1.00
TRUST_PROXY=1
PORT=8787
# Auf Render (nur mit RENDER_EXTERNAL_URL): eigene /healthz alle 10 Minuten aufrufen. 0 = aus.
KEEP_AWAKE=1
# Magic-Link-Mail über die Resend-HTTP-API. Ohne Schlüssel läuft die App weiter.
RESEND_API_KEY=
MAIL_FROM=
# Stripe-Abo. Ohne diese Werte zeigt die App „Pro bald verfügbar“ statt der Kauf-Buttons.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
